  test_run: {
    type: 'test',
    framework: 'pytest',
    uuid: '68529219-2f00-4bd6-9a24-a597a7326465',
    name: 'test_elpais_scraper',
    body: {
      lang: 'python',
      code: 'def test_elpais_scraper(driver):\n' +
        '\n' +
        '    # --- Step 1: visit El País, verify Spanish ---\n' +
        '    driver.get("https://elpais.com/")\n' +
        '    time.sleep(5)\n' +
        '\n' +
        '    soup = BeautifulSoup(driver.page_source, "lxml")\n' +
        '\n' +
        '    html_tag = soup.find("html")\n' +
        '    lang = html_tag.get("lang", "") if html_tag else ""\n' +
        `    assert "es" in lang, f"Expected Spanish language tag, got: '{lang}'"\n` +
        '\n' +
        '    print(f"\\nLanguage confirmed: {lang}")\n' +
        '\n' +
        '    # --- Step 2: scrape opinion articles ---\n' +
        '    all_urls = extract_opinion_urls(soup)\n' +
        '\n' +
        '    article_urls = [\n' +
        '        u for u in all_urls\n' +
        '        if "/opinion/" in u and not u.rstrip("/").endswith("/opinion")\n' +
        '    ][:5]\n' +
        '\n' +
        '    assert len(article_urls) > 0, "No opinion article URLs found on homepage"\n' +
        '\n' +
        '    print(f"\\nFound {len(article_urls)} opinion articles:")\n' +
        '    for url in article_urls:\n' +
        '        print(url)\n' +
        '\n' +
        '    spanish_titles = scrape_articles(driver, article_urls)\n' +
        '\n' +
        '    assert len(spanish_titles) == len(article_urls), (\n' +
        '        f"Expected {len(article_urls)} titles, got {len(spanish_titles)}"\n' +
        '    )\n' +
        '\n' +
        '    # --- Step 3: translate titles ---\n' +
        '    print("\\n==============================")\n' +
        '    print("TRANSLATING TITLES TO ENGLISH")\n' +
        '\n' +
        '    translated_titles = translate_titles_to_english(spanish_titles)\n' +
        '\n' +
        '    assert len(translated_titles) == len(spanish_titles), (\n' +
        '        "Translation API returned fewer results than expected"\n' +
        '    )\n' +
        '\n' +
        '    for es, en in zip(spanish_titles, translated_titles):\n' +
        '        print(f"\\nSpanish: {es}")\n' +
        '        print(f"English: {en}")\n' +
        '\n' +
        '    # --- Step 4: word analysis ---\n' +
        '    print("\\n==============================")\n' +
        '    print("REPEATED WORDS (count > 2)")\n' +
        '\n' +
        '    repeated_words = find_repeated_words(translated_titles, min_count=3)\n' +
        '\n' +
        '    if repeated_words:\n' +
        '        for word, count in repeated_words.items():\n' +
        '            print(f"{word} -> {count}")\n' +
        '    else:\n' +
        '        print("No words repeated more than twice.")\n' +
        '\n' +
        '    print("\\nPART 2 COMPLETE")\n'
    },
    identifier: 'test_elpais_scraper',
    scope: 'test_elpais_scraper',
